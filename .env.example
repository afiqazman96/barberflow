# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Values come from the Supabase dashboard for your project:
#   Project Settings → Database  (connection strings, DB password)
#   Project Settings → API       (project URL, anon key, service_role key)
#
# If your DB password contains @ : / ? # [ ] or a space, percent-encode it
# before pasting it into the URLs below (e.g. "p@ss" → "p%40ss").

# Both URLs go through the pooler. Do NOT use db.PROJECT_REF.supabase.co: that
# host publishes only an AAAA record, so it fails to resolve anywhere without
# IPv6 egress (most home ISPs, many CI runners) unless you buy the IPv4 add-on.
#
# App runtime. Prisma connects through the driver adapter (src/lib/prisma.ts),
# so this must be the pooler in **transaction mode** (port 6543) — serverless
# functions open and drop connections constantly and would exhaust a session.
DATABASE_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Prisma CLI only — migrate / db push / studio. Same host, **session mode**
# (port 5432): transaction mode cannot run DDL or hold the advisory lock that
# `prisma migrate` takes. Read by prisma.config.ts, never by the app.
DIRECT_URL="postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth. The URL and publishable key are shipped to the browser — that
# is expected; the publishable key is a public identifier, not a secret.
# New projects get an `sb_publishable_…` key; older ones a JWT-shaped `anon`
# key, which also works here (NEXT_PUBLIC_SUPABASE_ANON_KEY is read as a
# fallback).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Server-only. Bypasses every auth check. Never import this into a Client
# Component, never prefix it with NEXT_PUBLIC_, never commit a real value.
# Used for owner-provisions-staff (BACKEND_HANDOFF §6.2) and by the seed.
SUPABASE_SERVICE_ROLE_KEY=""
